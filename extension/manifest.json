{
  "manifest_version": 3,
  "name": "tvault",
  "version": "1.0.0",
  "description": "TOTP codes and passwords from your local tvault, over native messaging. Nothing is stored in the browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "tvault"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Open tvault"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
